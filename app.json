{
  "expo": {
    "name": "Rave",
    "slug": "rave",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rave",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070A",
    "ios": {
      "bundleIdentifier": "com.thecomputer07.rave",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Rave usa la fotocamera solo per leggere il codice QR di un invito a un gruppo.",
        "NSLocalNetworkUsageDescription": "Rave si collega al tuo server Jellyfin, che può trovarsi nella tua rete locale.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.thecomputer07.rave",
      "adaptiveIcon": {
        "backgroundColor": "#07070A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Rave usa la fotocamera solo per leggere il codice QR di un invito a un gruppo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/images/tv-banner.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
