{
  "expo": {
    "name": "JSync",
    "slug": "jsync",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "jsync",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070A",
    "ios": {
      "bundleIdentifier": "com.thecomputer07.jsync",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "JSync usa la fotocamera solo per leggere il codice QR di un invito a un gruppo.",
        "NSLocalNetworkUsageDescription": "JSync si collega al tuo server Jellyfin, che può trovarsi nella tua rete locale.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.thecomputer07.jsync",
      "adaptiveIcon": {
        "backgroundColor": "#07070A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "JSync usa la fotocamera solo per leggere il codice QR di un invito a un gruppo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-screen-orientation",
      [
        "expo-sensors",
        {
          "motionPermission": "JSync usa i sensori di movimento solo per bloccare il video sul lato in cui tieni il telefono."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/images/tv-banner.png"
        }
      ],
      "expo-localization",
      "react-native-google-cast"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "282e83de-2b22-4e13-8a2e-a995864afbf5"
      }
    },
    "owner": "thecomputer07"
  }
}
